//4 bit parllel adder design code
module full_adder(
  input a,b,c,
  output sum,cout);
  assign sum=a^b^c;
  assign cout=(a&b)|(a&c)|(b&c);
endmodule
module parallel_adder(
  input [3:0]a,b,
  input cin,
  output [3:0]sum,
  output carry);
  wire [2:0]c;
  full_adder fa1(a[0],b[0],cin,sum[0],c[0]);
  full_adder fa2(a[1],b[1],c[0],sum[1],c[1]);
  full_adder fa3(a[2],b[2],c[1],sum[2],c[2]);
  full_adder fa4(a[3],b[3],c[2],sum[3],carry);
endmodule


// 4bit parllel adder testbench code 
module parllel_adder;
  reg [3:0]a,b,c;
  wire [3:0]sum;
  wire carry;
  full_adder dut(a,b,c,sum,carry);
  always begin
    a=$random;
    b=$random;
    c=$random;
    #10;
  end
  initial begin
    $dumpfile("wave,vcd");
    $dumpvars(0,parllel_adder);
    $monitor("%b %b %b %b %b",a,b,c,sum,carry);
    #60;
    $finish;
  end
endmodule
  
