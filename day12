//sr latch design code
module sr_latch(
  input s,
  input r,
  output reg q,
  output q_bar);
  assign q_bar=~q;
  always@(s or r)begin
    if(s==0 && r==0)begin
      q=q;
    end
    else if(s==0&&r==1)begin
      q=0;
    end
    else if(s==1&&r==0)begin
      q=1;
    end
    else 
      q=1'bx;
  end
endmodule


//sr latch testbench code

module sr_latch_tb;
  reg s,r;
  wire q;
  wire q_bar;
  sr_latch dut(s,r,q,q_bar);
  initial begin
    $monitor("s=%b r=%b q=%b q_bar=%b",s,r,q,q_bar);
    $dumpfile("waveform.vcd");
    $dumpvars(0,sr_latch_tb);
    s=0;r=0;#10;
    s=1;r=0;#10;
    s=0;r=0;#10;
    s=0;r=1;#10;
    s=0;r=0;#10;
    s=1;r=1;#10;
    
    $finish;
  end
endmodule
    
    
              
