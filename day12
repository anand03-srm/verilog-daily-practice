//sr latch design code.
module sr_latch(
  input s,
  input r,
  output reg q,
  output q_bar);
  assign q_bar=~q;
  always@(s or r)begin
    if(s==0 && r==0)begin
      q=q;
    end
    else if(s==0&&r==1)begin
      q=0;
    end
    else if(s==1&&r==0)begin
      q=1;
    end
    else 
      q=1'bx;
  end
endmodule


//sr latch testbench code

module sr_latch_tb;
  reg s,r;
  wire q;
  wire q_bar;
  sr_latch dut(s,r,q,q_bar);
  initial begin
    $monitor("s=%b r=%b q=%b q_bar=%b",s,r,q,q_bar);
    $dumpfile("waveform.vcd");
    $dumpvars(0,sr_latch_tb);
    s=0;r=0;#10;
    s=1;r=0;#10;
    s=0;r=0;#10;
    s=0;r=1;#10;
    s=0;r=0;#10;
    s=1;r=1;#10;
    
    $finish;
  end
endmodule


//d latch design code

module d_latch(
  input D,
  input EN,
  input RST,
  output reg q);
  always@(*)begin
    if(RST)begin
      q=0;
    end
    else if(EN)begin
      q=D;
    end
  end
endmodule

//d latch testbench code
module d_latch_tb;
  reg D;
  reg EN;
  reg RST;
  wire q;
  d_latch dut(D,EN,RST,q);
  initial begin 
    $monitor("d=%b ena=%b reset=%b q=%b",D,EN,RST,q);
    $dumpfile("waveform.vcd");
    $dumpvars(0,d_latch_tb);
    RST=1; EN=0; D=0; #10;
    RST=0; EN=1; D=1; #10;
    RST=0; EN=0; D=0; #10;
    RST=0; EN=1; D=0; #10;
    RST=1; EN=1; D=1; #10;
    $finish;
  end
endmodule
    
    
              
