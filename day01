//behaviraol modling
module all_logic_gates(
  input a,b,
  output not_gate,
  output and_gate,
  output or_gate,
  output nand_gate,
  output nor_gate,
  output xor_gate,
  output xnor_gate
);
  assign not_gate=~a;
  assign and_gate=a&b;
  assign or_gate=a|b;
  assign nand_gate=~(a&b);
  assign nor_gate=~(a|b);
  assign xor_gate=a^b;
  assign xnor_gate=~(a^b);
endmodule
