//strutrual modling
module all_logic_gates(
  input a,b,
  output not_gate,
  output and_gate,
  output or_gate,
  output nand_gate,
  output nor_gate,
  output xor_gate,
  output xnor_gate
);
  not (not_gate,a);
  and (and_gate,a,b);
  or (or_gate,a,b);
  nand (nand_gate,a,b);
  nor (nor_gate,a,b);
  xor (xor_gate,a,b);
  xnor(xnor_gate,a,b);
endmodule

