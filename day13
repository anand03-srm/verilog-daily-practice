module d_to_t_ff(
    input clk,
    input rst,
    input T,
    output reg Q
);

wire D;

assign D = T ^ Q;

always @(posedge clk or posedge rst)
begin
    if(rst)
        Q <= 0;
    else
        Q <= D;
end

endmodule

module d_to_t_ff_tb;

reg clk;
reg rst;
reg T;

wire Q;

d_to_t_ff dut(
    .clk(clk),
    .rst(rst),
    .T(T),
    .Q(Q)
);

always #5 clk = ~clk;

initial
begin
    clk = 0;
    rst = 1;
    T = 0;

    #10 rst = 0;

    T = 0; #10;
    T = 1; #10;
    T = 1; #10;
    T = 0; #10;
    T = 1; #10;

    $finish;
end

endmodule


module sr_ff(
    input clk,
    input S,
    input R,
    output reg Q
);

always @(posedge clk)
begin
    case({S,R})
        2'b00: Q <= Q;      // Hold
        2'b01: Q <= 1'b0;   // Reset
        2'b10: Q <= 1'b1;   // Set
        2'b11: Q <= 1'bx;   // Invalid
    endcase
end

endmodule

module sr_to_jk(
    input clk,
    input J,
    input K,
    output Q
);

wire S;
wire R;
wire q_int;

assign S = J & ~q_int;
assign R = K & q_int;

sr_ff uut(
    .clk(clk),
    .S(S),
    .R(R),
    .Q(q_int)
);

assign Q = q_int;

endmodule

module sr_to_jk_tb;

reg clk;
reg J;
reg K;

wire Q;

sr_to_jk dut(
    .clk(clk),
    .J(J),
    .K(K),
    .Q(Q)
);

always #5 clk = ~clk;

initial
begin

    clk = 0;

    J = 0; K = 0; #10;   // Hold

    J = 1; K = 0; #10;   // Set

    J = 0; K = 0; #10;   // Hold

    J = 0; K = 1; #10;   // Reset

    J = 1; K = 1; #10;   // Toggle

    J = 1; K = 1; #10;   // Toggle

    J = 0; K = 0; #10;   // Hold

    $finish;

end

initial
begin
    $monitor("Time=%0t J=%b K=%b Q=%b",$time,J,K,Q);
end

endmodule
