// 1 bit camparator design code 

module one_camprator(
  input a,b,
  output less,
  output greater,
  output equal);
  assign greater=a&~b;
  assign less=~a&b;
  assign equal=~(a^b);
endmodule

//testbench code

module one_campartor_tb;
  reg a,b;
  wire greater,less,equal;
  one_camprator dut(a,b,greater,less,equal);
  initial begin
    $monitor("a=%b b=%b greater=%b less=%b equal=%b",a,b,greater,less,equal);
    $dumpfile("wave.vcd");
    $dumpvars(0,one_campartor_tb);
    a=0;b =0;#10;
    a=0;b =1;#10;
    a=1;b =0;#10;
    a=1;b =1;#10;
    $finish;
  end
endmodule

//4 bit camparator design code

module four_bit_camparator(
  input [3:0]a,b,
  output greater,less,equal);
  assign greater=(a>b);
  assign less=(a<b);
  assign equal=(a==b);
endmodule

//4 bit camprator testbench code 

module four_bit_camparator_tb;
  reg [3:0]a,b;
  wire greater,less,equal;
  four_bit_camparator dut (a,b,greater,less,equal);
  initial begin
    $strobe("a=%d b=%d greater=%b less=%b equal=%b",a,b,greater,less,equal);
    $dumpfile("wave.vcd");
    $dumpvars(0,four_bit_camparator_tb);
    a=4'd8;b=4'd7;#10;
    a=4'd8;b=4'd7;#10;
    a=4'd7;b=4'd7;#10;
    a=4'd8;b=4'd0;#10;
    $finish;
  end
endmodule

//2:1 mux design code

module two_one(
  input a,b,
  input sel,
  output reg y);
  always@(*)begin
    case(sel)
      1'b0:y=a;
      1'b0:y=b;
    endcase
  end
endmodule


//2:1 mux testbench code

module two_on_tb;
  reg a,b,sel;
  wire y;
  two_one dut(a,b,sel,y);
  initial begin 
    $monitor("a=%b b=%b sel=%b y=%b",a,b,sel,sel,y);
    a=0;b=1;
    sel=0;#10;
    sel=1;#10;
    a=1;b=0;
    sel=1;#10;
    sel=0;#10;
    $finish;
  end
endmodule
      
