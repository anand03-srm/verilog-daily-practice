//2:4 decoder design code
module decoder2_4(
  input [1:0]in,
  output reg [3:0]out);
  always@(*)begin
    case(in)
      2'b00:out=4'b0001;
      2'b01:out=4'b0010;
      2'b10:out=4'b0100;
      2'b11:out=4'b1000;
    endcase
  end
endmodule

module decoder2_4_tb;
  reg [1:0]in;
  wire [3:0]out;
  decoder2_4 dut(in,out);
  initial begin
    $dumpfile("wave.vcd");
    $dumpvars(0,decoder2_4_tb);
    $monitor("in =%b out=%b ",in,out);
    in=2'b00;#10;
    in=2'b01;#10;
    in=2'b10;#10;
    in=2'b11;#10;
    $finish;
  end
endmodule

//3:8 decoder design code
module decoder3_8(
  input [2:0]in,
  output reg [7:0]out);
  always@(*)begin
    case(in)
      3'b000:out=8'b00000001;
      3'b001:out=8'b00000010;
      3'b010:out=8'b00000100;
      3'b011:out=8'b00001000;
      3'b100:out=8'b00010000;
      3'b101:out=8'b00100000;
      3'b110:out=8'b01000000;
      3'b111:out=8'b10000000;
      endcase
  end
endmodule
  
  
